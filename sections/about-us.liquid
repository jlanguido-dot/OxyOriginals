{% schema %}
{
  "name": "About Us Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "about_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Us"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Write something about your brand, story or mission here.</p>"
    }
  ],
  "presets": [
    {
      "name": "About Us Section"
    }
  ]
}
{% endschema %}

<div class="about-us-section" style="text-align:center; padding: 40px;">
  {% if section.settings.about_image != blank %}
    <img src="{{ section.settings.about_image | img_url: 'medium' }}" alt="About Us Image" style="max-width: 100%; height: auto; margin-bottom: 20px;">
  {% endif %}

  <h2>{{ section.settings.heading }}</h2>

  <div>{{ section.settings.content }}</div>
</div>
