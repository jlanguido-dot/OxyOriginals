  // search functionality
  function searchThroughCountries() {
    // Declare variables
    var input, filter, ul, li, a, i, txtValue;
    input = document.getElementById('country-search');
    filter = input.value.toUpperCase();
    ul = document.getElementById("country-options");
    li = ul.getElementsByTagName('li');
  
    // Loop through all list items, and hide those who don't match the search query
    for (i = 0; i < li.length; i++) {
      a = li[i].getElementsByTagName("span")[0];
      txtValue = a.textContent || a.innerText;
      if (txtValue.toUpperCase().indexOf(filter) > -1) {
        li[i].style.display = "";
      } else {
        li[i].style.display = "none";
      }
    }
  }

  var countryGlobeIcon = document.getElementById("country-globe-icon")
  var countryInStorage = localStorage.getItem("country")
  function setGlobeToGlobe() {
    countryGlobeIcon.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--! Font Awesome Pro 6.2.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2022 Fonticons, Inc. --><path fill="currentColor" d="M352 256c0 22.2-1.2 43.6-3.3 64H163.3c-2.2-20.4-3.3-41.8-3.3-64s1.2-43.6 3.3-64H348.7c2.2 20.4 3.3 41.8 3.3 64zm28.8-64H503.9c5.3 20.5 8.1 41.9 8.1 64s-2.8 43.5-8.1 64H380.8c2.1-20.6 3.2-42 3.2-64s-1.1-43.4-3.2-64zm112.6-32H376.7c-10-63.9-29.8-117.4-55.3-151.6c78.3 20.7 142 77.5 171.9 151.6zm-149.1 0H167.7c6.1-36.4 15.5-68.6 27-94.7c10.5-23.6 22.2-40.7 33.5-51.5C239.4 3.2 248.7 0 256 0s16.6 3.2 27.8 13.8c11.3 10.8 23 27.9 33.5 51.5c11.6 26 21 58.2 27 94.7zm-209 0H18.6C48.6 85.9 112.2 29.1 190.6 8.4C165.1 42.6 145.3 96.1 135.3 160zM8.1 192H131.2c-2.1 20.6-3.2 42-3.2 64s1.1 43.4 3.2 64H8.1C2.8 299.5 0 278.1 0 256s2.8-43.5 8.1-64zM194.7 446.6c-11.6-26-20.9-58.2-27-94.6H344.3c-6.1 36.4-15.5 68.6-27 94.6c-10.5 23.6-22.2 40.7-33.5 51.5C272.6 508.8 263.3 512 256 512s-16.6-3.2-27.8-13.8c-11.3-10.8-23-27.9-33.5-51.5zM135.3 352c10 63.9 29.8 117.4 55.3 151.6C112.2 482.9 48.6 426.1 18.6 352H135.3zm358.1 0c-30 74.1-93.6 130.9-171.9 151.6c25.5-34.2 45.2-87.7 55.3-151.6H493.4z"/></svg>`
  }
  function setGlobeToCountry(countryCode) {
          var c = localStorage.getItem("country")
          countryGlobeIcon.innerHTML = `<img class="country-item-choice-flag" src="https://hatscripts.github.io/circle-flags/flags/${c.toLowerCase()}.svg" width="25" />`
  }

  if(countryInStorage && countryInStorage !== "placeholder") {
        setGlobeToCountry(countryInStorage)
  } else {
    setGlobeToGlobe()
  }

  var settings = {{ schema_settings | json }}

    // filter through countries based on settings
      var countryListModified = countryList.filter(function(c) {
      var currentSetting = `country_select_option_${c.code}`
      var shouldKeep = settings[currentSetting]
      return shouldKeep === true
    })

    function getCountryLink(code) {
    var link = `country_select_link_${code}`
    return settings[link]
  }

      // open and close menu functionality
      const mobileCountryBtn = document.querySelector('.mobile-globe-button')
    const mobileCountryClose = document.querySelector('.mobile-country-select-close')
    const mobileCountrySelect = document.querySelector('.mobile-country-select')

        // open menu automatically if no country selected
  if(window.innerWidth <= 798 && (!localStorage.getItem("country") || localStorage.getItem("country") === "placeholder")) {
    mobileCountrySelect.classList.toggle('isActive')
  }

    mobileCountryBtn.addEventListener('click', function () {
        if(countryOptions?.getElementsByTagName("li").length === 0) {
        countryListModified.map((country) => { 
        var countryListItem = document.createElement("li")
        countryListItem.class = "country-list-item"
        countryListItem.innerHTML = `<button id="country-item-${country.code}" class="country-item"><div class="country-item-image"><img class="country-item-choice-flag" src="https://hatscripts.github.io/circle-flags/flags/${country.code.toLowerCase()}.svg" width="25" /></div><span class="country-item-name">${country.name}</span></button>`
        countryOptions.append(countryListItem)
    
        var countryItemButton = document.getElementById(`country-item-${country.code}`) 
        countryItemButton.addEventListener("click", function() {
            var link = getCountryLink(country.code)
          
            if (link.includes("https://oxyoriginals.ph")) {
              localStorage.setItem("country", "placeholder")
              window.location.href = link
              setGlobeToGlobe()
              mobileCountrySelect.classList.toggle('isActive')
              return
            }
          
            window.history.replaceState(null, null, window.location.pathname);
          
          localStorage.setItem("country", country.code);
          setGlobeToCountry(country.code)
          mobileCountrySelect.classList.toggle('isActive')
        })
      })
        }
        mobileCountrySelect.classList.toggle('isActive')
      document.getElementById('country-search').focus()
      }
    )

    mobileCountryClose.addEventListener('click', function () {
        mobileCountrySelect.classList.toggle('isActive')
      }
    )
  
  countryListModified.map((country) => { 
    var countryListItem = document.createElement("li")
    countryListItem.class = "country-list-item"
    countryListItem.innerHTML = `<button id="country-item-${country.code}" class="country-item"><div class="country-item-image"><img class="country-item-choice-flag" src="https://hatscripts.github.io/circle-flags/flags/${country.code.toLowerCase()}.svg" width="25" /></div><span class="country-item-name">${country.name}</span></button>`
    countryOptions.append(countryListItem)

    var countryItemButton = document.getElementById(`country-item-${country.code}`) 
    countryItemButton.addEventListener("click", function() {
        var link = getCountryLink(country.code)
      
        if (link.includes("https://oxyoriginals.ph")) {
          localStorage.setItem("country", "placeholder")
          window.location.href = link
          setGlobeToGlobe()
          mobileCountrySelect.classList.toggle('isActive')
          return
        }
      
        window.history.replaceState(null, null, window.location.pathname);
      
      localStorage.setItem("country", country.code);
      setGlobeToCountry(country.code)
      mobileCountrySelect.classList.toggle('isActive')
    })
  })

  window.addEventListener('resize', function(event) {
      var cs = localStorage.getItem("country");
     if(cs && cs !== "placeholder") {
       setGlobeToCountry(cs)
     }
  });

</script>