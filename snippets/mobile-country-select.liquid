{%- assign schema_settings = settings -%}

<div class="mobile-country-select">
  <button class="mobile-country-select-close">
    x
  </button>
   <h1 class="mobile-country-select-heading">Select your Country</h1>
  <input type="text" id="country-search" onkeyup="searchThroughCountries()" class="country-search" />
  <div class="country-options-container">
     <ul id="country-options" class="country-options"></ul> 
  </div>
</div>

<style>
    .mobile-globe-button  {
    background: none !important;
    color: white;
    font-size: 16px;
    border: none !important;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    position: absolute;
    left: 55px;
    width: 30px;
      height: 40px;
  }

  .country-globe-icon {
    width: 25px;
    height: 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    position: relative;
    top: -1px;
  }

    .country-globe-icon svg{
    width: 18px;
    height: 18px;
    color: white;
  }
  
  .mobile-country-select {
    display: flex;
    position: fixed;
    top: 0;
    right: 100%;
    width: 100%;
    height: 100vh;
    z-index: 99999;
    background-color: #000;
    color: white;
    transition: all 0.2s ease;
    display: flex;
    flex-flow: column nowrap;
    padding: 20px;
    opacity: 0.85;
  }

  .mobile-country-select.isActive {
    right: 0%;
  }

  .mobile-country-select-close {
    margin: 0px 0px 0 0;
    align-self: flex-end;
    background: none !important;
    width: 20px;
    height: 20px;
    color: white;
    font-weight: 900;
    font-size: 20px;
  }

  .mobile-country-select-heading {
    margin: 15px;
    text-align: center;
    color: white;
    font-family: Montserrat,sans-serif;
    font-size: 20px;
    font-weight: 500;
    font-style: normal;
  }

  .country-search {
    margin: 10px 0 20px 0;
    min-height: 40px;
    font-size: 15px;
    padding: 0px 15px;
    border: none;
    font-family: Montserrat,sans-serif;
    border-radius: 15px;
    color: black;
    flex: 0 1 auto
  }

  .country-options-container {
    overflow-y: auto;
    flex: 1 1 auto;
    margin-top: 10px;
  }

    .country-options-container::-webkit-scrollbar {
  -webkit-appearance: none;
  width: 4px;
}

.country-options-container::-webkit-scrollbar-thumb {
  border-radius: 5px;
  background-color: #c9c9c9;
  -webkit-box-shadow: 0 0 1px rgba(255,255,255,.5);
}

  .country-options {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .country-item {
    display: flex;
    flex-flow: row nowrap;
    margin-bottom: 40px;
    background: none;
  }

    .country-item:hover {
    background: none;
    border: none;
  }

  .country-item-name {
    font-size: 14px;
    color: white;
    font: Montserrat,sans-serif;
    text-align: left;
  }

    .country-item-name:hover {
    color: #969595 !important;
  }

  .country-item-choice-flag {
  width: 25px;
  margin-right: 15px;
  color: white;
      position: relative;
    top: -1px;
}
</style>

